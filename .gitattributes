# 统一换行符：本项目只面向 Windows，源码用 CRLF，文档用 LF
* text=auto

*.cs        text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.manifest  text eol=crlf
*.config    text eol=crlf
*.gitignore text eol=crlf
*.gitattributes text eol=crlf
*.md        text eol=lf

# 二进制资源，不做换行转换
*.png  binary
*.ico  binary
*.exe  binary
*.dll  binary
